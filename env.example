# Banco: em produção e no Vercel use PostgreSQL. Sem DATABASE_URL o sistema usa SQLite local.
# Supabase no Vercel: use a URL do pooler em modo transação (porta 6543).
DATABASE_URL=
ANTEVE_DB=/app/data/anteve.db
# Segredo exigido pelos endpoints /api/cron/* (Vercel Cron e GitHub Actions)
CRON_SECRET=
# Vercel: tempo máximo de trabalho por chamada e tribunais processados em paralelo
ANTEVE_ORCAMENTO_S=45
ANTEVE_PARALELO=6
# Coleta
ANTEVE_TRIBUNAIS=tjac,tjal,tjam,tjap,tjba,tjce,tjdft,tjes,tjgo,tjma,tjmg,tjms,tjmt,tjpa,tjpb,tjpe,tjpi,tjpr,tjrj,tjrn,tjro,tjrr,tjrs,tjsc,tjse,tjsp,tjto
ANTEVE_INTERVALO_MIN=45
ANTEVE_SOBREPOSICAO_H=72
ANTEVE_JANELA_CAPTURA_DIAS=365
ANTEVE_RECONC_DIARIA_DIAS=30
ANTEVE_RECONC_MENSAL_DIAS=365
# Definição de novo (seção 3.3)
ANTEVE_NOVO_DIAS=7
ANTEVE_RECENTE_DIAS=30
# Chave pública do DataJud: conferir periodicamente em https://datajud-wiki.cnj.jus.br/api-publica/acesso/
DATAJUD_API_KEY=cDZHYzlZa0JadVREZDJCendQbXY6SkJlTzNjLV9TRENyQk1RdnFKZGRQdw==
DJEN_HABILITADO=1
# Classificador de IA (opcional)
ANTHROPIC_API_KEY=
ANTEVE_MODELO_IA=claude-sonnet-5
# Camada preventiva exige revisão humana antes de alertar
ANTEVE_PREVENTIVO_REVISAO=1
# E-mail
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=anteve@seudominio.com.br
